<Page x:Class="小玩意.PlcMessagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:小玩意"
      xmlns:controls="clr-namespace:小玩意.Controls"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1400"
      Background="#FFF5F5F5"
      Title="PlcMessagePage">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶部工具栏 ============ -->
        <Border Grid.Row="0" Background="#FFF5F5F5" Padding="24,16,24,12"
                BorderBrush="#FFE5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PLC 信息" FontSize="21" FontWeight="SemiBold" Foreground="#FF111827"/>
                    <TextBlock Text="西门子 S7 通讯 · 设备与点位实时监控"
                               FontSize="12" Foreground="#FF6B7280" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="12" Padding="12,5"
                            BorderBrush="#FFE5E7EB" BorderThickness="1" Margin="0,0,12,0">
                        <TextBlock Text="{Binding MyDataValue.Count, StringFormat={}{0} 个点位}"
                                   FontSize="12" Foreground="#FF374151"/>
                    </Border>

                    <Button Content="连接 / 刷新"
                            Command="{Binding ConnCommand}"
                            Style="{StaticResource ModernButtonStyle1}"
                            Width="120" Height="36" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            主体直接复用 PLC 详细信息面板。
            作用：与「连接设备」页里嵌的是同一个控件。
            目的：这两处展示的是同一份数据，如果各写一套界面，
                  以后调列宽或加一列就得改两个文件，很快就会不一致。
        -->
        <Grid Grid.Row="1" Margin="20">
            <controls:PlcDetailPanel/>
        </Grid>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="2" Background="White" Padding="24,10"
                BorderBrush="#FFE5E7EB" BorderThickness="0,1,0,0">
            <TextBlock Text="提示：本页只做展示，PLC 的实际连接在「连接设备」页完成。"
                       FontSize="12" Foreground="#FF9CA3AF"/>
        </Border>
    </Grid>
</Page>
