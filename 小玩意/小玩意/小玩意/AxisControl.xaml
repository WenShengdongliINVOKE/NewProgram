<Page x:Class="小玩意.AxisControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:小玩意"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1400"
      Background="#FFF5F6F8"
      Title="AxisControl">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 浅色工具按钮：白底细边框，避免整页都是渐变按钮显得花 -->
            <Style x:Key="ToolButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="36"/>
                <Setter Property="MinWidth" Value="84"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#FF374151"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#FFD1D5DB"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFEFF6FF"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF93C5FD"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFF3F4F6"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FFE5E7EB"/>
                                    <Setter Property="Foreground" Value="#FF9CA3AF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 停止按钮：红色描边，与普通操作明确区分，避免误点 -->
            <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
                <Setter Property="Foreground" Value="#FFB91C1C"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="White"
                                    BorderBrush="#FFFCA5A5"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFFEF2F2"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FFEF4444"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFF3F4F6"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FFE5E7EB"/>
                                    <Setter Property="Foreground" Value="#FF9CA3AF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 卡片容器 -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="18"/>
            </Style>

            <!-- 小型输入框 -->
            <Style x:Key="FieldBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Width" Value="96"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderBrush" Value="#FFD1D5DB"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- 轴列表项 -->
            <Style x:Key="AxisItemStyle" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd"
                                    Background="#FFF9FAFB"
                                    BorderBrush="#FFE5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,9">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFF3F4F6"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFEFF6FF"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF1E88E5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 分组小标题 -->
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#FF6B7280"/>
                <Setter Property="Margin" Value="0,20,0,10"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶部工具栏 ============ -->
        <Border Grid.Row="0" Background="White" Padding="24,14"
                BorderBrush="#FFE5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="轴控制" FontSize="21" FontWeight="SemiBold" Foreground="#FF111827"/>
                    <TextBlock Text="正运动控制器 · 单轴调试与定位"
                               FontSize="12" Foreground="#FF6B7280" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="控制器 IP" FontSize="12" Foreground="#FF6B7280"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding ControllerIp, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldBoxStyle}"
                             Width="140" Margin="0,0,10,0"/>
                    <Button Content="连接" Command="{Binding ConnectCommand}"
                            Style="{StaticResource ModernButtonStyle1}"
                            Width="84" Height="36" FontSize="13" Margin="0,0,8,0"/>
                    <Button Content="断开" Command="{Binding DisconnectCommand}"
                            Style="{StaticResource ToolButtonStyle}" Margin="0,0,14,0"/>

                    <Border CornerRadius="12" Padding="12,5" Background="#FFF3F4F6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FF9CA3AF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="#FF16A34A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionBadgeText}" FontSize="12" Foreground="#FF374151"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 主体 ============ -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 轴列表 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="轴列表" FontSize="14" FontWeight="SemiBold" Foreground="#FF374151"/>
                        <TextBlock Text="{Binding Axes.Count, StringFormat={}{0} 轴}"
                                   FontSize="12" Foreground="#FF9CA3AF" HorizontalAlignment="Right"/>
                    </Grid>

                    <ListBox ItemsSource="{Binding Axes}"
                             SelectedItem="{Binding SelectedAxis}"
                             ItemContainerStyle="{StaticResource AxisItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="14" Foreground="#FF111827"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11" Foreground="#FF9CA3AF" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Position, StringFormat={}{0:F3}}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="#FF1E88E5" HorizontalAlignment="Right"/>
                                        <TextBlock Text="位置" FontSize="10" Foreground="#FF9CA3AF"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 操作面板 -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="16,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedAxisTitle}"
                                   FontSize="17" FontWeight="SemiBold" Foreground="#FF111827"/>
                        <TextBlock Text="所有操作只作用于左侧当前选中的轴"
                                   FontSize="12" Foreground="#FF9CA3AF" Margin="0,4,0,0"/>

                        <!-- 运动参数 -->
                        <TextBlock Text="运动参数" Style="{StaticResource SectionTitleStyle}"/>
                        <WrapPanel>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="速度" FontSize="11" Foreground="#FF9CA3AF" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding JogSpeed, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource FieldBoxStyle}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="加减速度" FontSize="11" Foreground="#FF9CA3AF" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Acceleration, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource FieldBoxStyle}"/>
                            </StackPanel>
                        </WrapPanel>

                        <!-- 伺服使能 -->
                        <TextBlock Text="伺服使能" Style="{StaticResource SectionTitleStyle}"/>
                        <WrapPanel>
                            <Button Content="上使能" Command="{Binding EnableCommand}"
                                    Style="{StaticResource ToolButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="下使能" Command="{Binding DisableCommand}"
                                    Style="{StaticResource ToolButtonStyle}"/>
                        </WrapPanel>

                        <!-- 点动 -->
                        <TextBlock Text="点动（按住后需点停止结束）" Style="{StaticResource SectionTitleStyle}"/>
                        <WrapPanel>
                            <Button Content="负向点动" Command="{Binding JogBackwardCommand}"
                                    Style="{StaticResource ToolButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="正向点动" Command="{Binding JogForwardCommand}"
                                    Style="{StaticResource ToolButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="停止" Command="{Binding StopCommand}"
                                    Style="{StaticResource StopButtonStyle}" MinWidth="96"/>
                        </WrapPanel>

                        <!-- 绝对定位 -->
                        <TextBlock Text="绝对定位" Style="{StaticResource SectionTitleStyle}"/>
                        <WrapPanel>
                            <TextBox Text="{Binding MoveTarget, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource FieldBoxStyle}" Width="120" Margin="0,0,10,0"/>
                            <Button Content="移动到目标" Command="{Binding MoveCommand}"
                                    Style="{StaticResource ToolButtonStyle}"/>
                        </WrapPanel>

                        <!-- 回零 -->
                        <TextBlock Text="回零" Style="{StaticResource SectionTitleStyle}"/>
                        <WrapPanel>
                            <TextBlock Text="模式" FontSize="12" Foreground="#FF6B7280"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding HomeMode, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource FieldBoxStyle}" Width="70" Margin="0,0,10,0"/>
                            <Button Content="执行回零" Command="{Binding HomeCommand}"
                                    Style="{StaticResource ToolButtonStyle}"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="2" Background="White" Padding="24,10"
                BorderBrush="#FFE5E7EB" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="状态" FontSize="11" Foreground="#FF9CA3AF"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="#FF111827"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
