<Page x:Class="小玩意.ConnectDevice"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:小玩意"
      xmlns:controls="clr-namespace:小玩意.Controls"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1400"
      Background="#FFF5F5F5"
      Title="ConnectDevice">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                导航树的条目样式。
                作用：把 System.Windows.Controls.TreeViewItem 的默认外观（虚线、加号方块）整个换掉，
                      改成左箭头 + 圆角高亮条的样式。
                目的：默认样式在深色背景上很难看、且默认选中高亮是系统蓝白配色，与整体不搭；
                      自绘一份才能保证深色导航栏下的可读性。
            -->
            <Style x:Key="NavTreeItemStyle" TargetType="TreeViewItem">
                <!-- 展开状态与选中状态都双向绑到模型，界面重启或代码改选中时能同步回来 -->
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                <Setter Property="Foreground" Value="#FF374151"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <StackPanel>
                                <Border x:Name="ItemBorder"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,1"
                                        Padding="6,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 展开箭头：只有带子项的节点才显示，由触发器控制 -->
                                        <ToggleButton x:Name="Expander"
                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                      ClickMode="Press"
                                                      Focusable="False">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" Width="18" Height="18">
                                                        <Path x:Name="Arrow"
                                                              Data="M 0 0 L 4 4 L 0 8 Z"
                                                              Fill="#FF9CA3AF"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              RenderTransformOrigin="0.5,0.5"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="90"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>

                                        <ContentPresenter Grid.Column="1"
                                                          ContentSource="Header"
                                                          VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0"/>
                            </StackPanel>

                            <ControlTemplate.Triggers>
                                <!-- 收起时隐藏子项容器；不隐藏的话箭头转了但列表还在 -->
                                <Trigger Property="IsExpanded" Value="False">
                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <!-- 叶子节点没有子项，箭头占位隐藏（用 Hidden 保留缩进对齐） -->
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FFFDF3EC"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FFFDF3EC"/>
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FFF57A7A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 导航项左侧的品牌徽标 -->
            <Style x:Key="NavBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="#FFF3F4F6"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- 右侧内容卡片 -->
            <Style x:Key="PanelCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>

        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧导航栏 ============ -->
        <Border Grid.Column="0" Background="White" BorderBrush="#FFE5E7EB" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="76" Background="#FFF5F5F5"
                        BorderBrush="#FFE5E7EB" BorderThickness="0,0,0,1">
                    <StackPanel VerticalAlignment="Center" Margin="20,0">
                        <TextBlock Text="设备导航" Foreground="#FF111827" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding NavSummary}"
                                   Foreground="#FF6B7280" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="20,12" Background="#FFF5F5F5"
                        BorderBrush="#FFE5E7EB" BorderThickness="0,1,0,0">
                    <TextBlock Text="展开分组，点击品牌查看通讯参数"
                               Foreground="#FF9CA3AF" FontSize="11" TextWrapping="Wrap"/>
                </Border>

                <!--
                    导航树。
                    作用：绑定 NavGroups，逐层展开到各品牌。
                    目的：SelectedItem 是只读依赖属性，无法直接双向绑定，
                          所以用 SelectedItemChanged 事件把选中项写回视图模型（见代码后置文件）。
                -->
                <TreeView x:Name="DeviceTree"
                          ItemsSource="{Binding NavGroups}"
                          SelectedItemChanged="DeviceTree_SelectedItemChanged"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="10"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.Resources>
                        <!--
                            用隐式样式而不是 ItemContainerStyle。
                            作用：让第一层的分组和第二层的品牌条目都用同一套深色样式。
                            目的：ItemContainerStyle 只作用于 TreeView 的直接子项，
                                  嵌套的品牌节点会退回系统默认外观（白底黑字 + 虚线），
                                  在深色导航栏上几乎看不清；隐式样式沿可视树查找，能覆盖所有层级。
                        -->
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource NavTreeItemStyle}"/>
                    </TreeView.Resources>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource NavBadgeStyle}">
                                    <TextBlock Text="{Binding Badge}"
                                               Foreground="#FFB45309"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="#FF111827"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}"
                                               Foreground="#FF9CA3AF"
                                               FontSize="11"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- ============ 右侧内容区 ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 品牌标题栏：未选中时显示占位文案（由视图模型的默认值给出，不需要额外切换可见性） -->
            <Border Grid.Row="0"
                    Background="White"
                    Padding="28,18"
                    BorderBrush="#FFE5E7EB"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border CornerRadius="8" Width="52" Height="52">
                        <Border.Background>
                            <!-- 与主界面导航按钮同一条暖色渐变，让两处视觉语言一致 -->
                            <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                                <GradientStop Color="#FFC548" Offset="0"/>
                                <GradientStop Color="#FFF57A7A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{Binding SelectedBadge}"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedTitle}"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="#FF111827"/>
                        <TextBlock Text="{Binding SelectedSubtitle}"
                                   FontSize="12"
                                   Foreground="#FF6B7280"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Border Background="#FFFDF3EC" CornerRadius="12" Padding="12,4" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding SelectedProtocol}"
                                       FontSize="12"
                                       Foreground="#FFB45309"/>
                        </Border>
                        <TextBlock Text="{Binding ImplementationText}"
                                   FontSize="11"
                                   Foreground="#FF9CA3AF"
                                   HorizontalAlignment="Right"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel>
                    <!-- 说明卡片 -->
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel>
                            <TextBlock Text="说明"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#FF374151"/>
                            <TextBlock Text="{Binding SelectedDescription}"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       Foreground="#FF4B5563"
                                       LineHeight="22"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ============ PLC 详细信息（选中 PLC 品牌后唤醒） ============ -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <!-- 没有详情模型时整块收起，避免留下一个空表格 -->
                                    <DataTrigger Binding="{Binding PlcDetail}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!--
                            把详情视图模型显式传给面板。
                            作用：面板内部不需要知道自己属于哪个页面，只管绑定传进来的对象。
                            目的：这样同一块面板既能嵌在这里，也能给独立的 PLC 信息页用。
                        -->
                        <controls:PlcDetailPanel DataContext="{Binding PlcDetail}"/>
                    </Grid>

                    <!-- 非西门子品牌：通讯类尚未实现，给出明确提示而不是空白 -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource PanelCardStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsPlcSelected}" Value="True"/>
                                            <Condition Binding="{Binding PlcDetail}" Value="{x:Null}"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <TextBlock Text="PLC 详细信息"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#FF374151"/>
                            <TextBlock Text="该品牌的通讯类尚未实现，暂无点位数据。通讯补上之后，这里会自动显示设备列表与实时点位。"
                                       TextWrapping="Wrap" FontSize="12"
                                       Foreground="#FF9CA3AF" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部操作栏 -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#FFE5E7EB"
                    BorderThickness="0,1,0,0"
                    Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="连接状态" FontSize="11" Foreground="#FF9CA3AF"/>
                        <TextBlock Text="{Binding ConnectionStateText}"
                                   FontSize="14"
                                   Foreground="#FF111827"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="连接选中设备"
                            Command="{Binding ConnectCommand}"
                            Width="160"
                            Height="40"
                            FontSize="14"
                            Style="{StaticResource ModernButtonStyle1}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
